# Roqqu
ROQQU_API_KEY=your_key_here
ROQQU_MODE=test            # test -> x-staging-api-key header, live -> x-api-key
ROQQU_WEBHOOK_SECRET=      # used to verify webhook signatures (see roqqu.py TODO)

# Run without calling Roqqu at all (fake addresses, fake sends). Keep 1 until the real endpoints are wired.
ASTERA_MOCK=1

# Safety checks that call external services (GoPlus, public RPCs). Set 0 to run fully offline.
ASTERA_EXTERNAL_CHECKS=1

# Optional: plain-English explanations written by Claude. Falls back to a template if unset.
ANTHROPIC_API_KEY=

# Optional RPC overrides for the "is this address a contract?" check
RPC_BEP20=https://bsc-dataseed.binance.org
RPC_BASE=https://mainnet.base.org

DATABASE_URL=sqlite:///./astera.db
INVOICE_TTL_HOURS=48
